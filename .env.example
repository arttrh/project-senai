# ═══════════════════════════════════════════════════════════════════════════
# Variaveis de ambiente da Cantina SENAI
#
# Copie este arquivo para .env e preencha os valores:
#
#     cp .env.example .env
#
# O .env fica fora do versionamento (esta no .gitignore) porque guarda senhas.
# Este .example e a lista completa e versionada de tudo que a aplicacao le do
# ambiente, para ninguem precisar caçar variavel dentro do codigo.
#
# O docker-compose.yml le este arquivo automaticamente.
# ═══════════════════════════════════════════════════════════════════════════

# ── Banco de dados ─────────────────────────────────────────────────────────
# Rodando pelo docker compose, o host e "banco" (nome do servico).
# Rodando o Maven na maquina com um MySQL local, troque para localhost.
SPRING_DATASOURCE_URL=jdbc:mysql://banco:3306/cantinasenai?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=America/Sao_Paulo
SPRING_DATASOURCE_USERNAME=cantina
SPRING_DATASOURCE_PASSWORD=troque-esta-senha

# Usadas pelo container do MySQL no docker compose.
MYSQL_ROOT_PASSWORD=troque-a-senha-de-root
MYSQL_DATABASE=cantinasenai
MYSQL_USER=cantina
MYSQL_PASSWORD=troque-esta-senha

# Tamanho do pool de conexoes.
DB_POOL_MAX=10
DB_POOL_TIMEOUT_MS=20000

# ── Servidor ───────────────────────────────────────────────────────────────
SERVER_PORT=8080

# Tempo de inatividade ate a sessao expirar.
SESSION_TIMEOUT=30m

# true em producao (cookie de sessao so trafega por HTTPS).
# Em desenvolvimento sem TLS precisa ficar false, senao o login nao completa.
COOKIE_SECURE=false

# ── Administrador inicial ──────────────────────────────────────────────────
# Criado no primeiro boot, apenas se ainda nao existir nenhum ADMIN.
# Deixe em branco para nao criar (ver AdministradorInicialRunner).
# A senha precisa de no minimo 8 caracteres e so o hash BCrypt vai para o banco.
APP_ADMIN_NOME=Administrador da Cantina
APP_ADMIN_CPF=
APP_ADMIN_EMAIL=admin@senai.br
APP_ADMIN_SENHA=troque-esta-senha-tambem

# ── Logs e diagnostico ─────────────────────────────────────────────────────
# DEBUG ajuda a investigar; mantenha INFO em producao.
LOG_LEVEL_APP=INFO

# WARN em producao. DEBUG imprime todo SQL executado.
LOG_LEVEL_SQL=WARN

# Nunca deixe true em producao: joga os parametros das queries no log.
JPA_SHOW_SQL=false

# ── Desenvolvimento ────────────────────────────────────────────────────────
# false recarrega os templates sem reiniciar a aplicacao. true em producao.
THYMELEAF_CACHE=true
